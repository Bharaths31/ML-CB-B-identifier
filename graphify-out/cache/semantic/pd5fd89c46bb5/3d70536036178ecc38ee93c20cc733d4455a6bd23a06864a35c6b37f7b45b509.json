ithout increasing on-device size/latency."}, {"id": "tflite_int8", "label": "TFLite INT8 (converter PTQ)", "file_type": "concept", "source_file": "docs/android-deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-integer PTQ calibrated on ~500 real train images. Static batch-1 [1,3,260,260] input with ImageNet normalization baked in, RGB float32 [0,1]. Must stay within 1 pt combined_top1 of fp32 or fall back to FP32 TFLite."}, {"id": "onnx_runtime_mobile_int8", "label": "ONNX Runtime Mobile INT8 (QDQ)", "file_type": "concept", "source_file": "docs/android-deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QDQ static quantization with per-channel weights, calibrated on real train images; gives ~7.1 MB vs ~25.7 MB fp32."}, {"id": "parity_gate", "label": "Export parity gate", "file_type": "concept", "source_file": "docs/android-deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INT8 artifacts must stay within 1 pt combined_top1 of fp32; otherwise ship the FP32 TFLite fallback emitted alongside."}], "edges": [{"source": "docs_android_deployment", "target": "src_train", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/android-deployment.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_deployment", "target": "src_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/android-deployment.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_deployment", "target": "src_parity_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/android-deployment.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_deployment", "target":