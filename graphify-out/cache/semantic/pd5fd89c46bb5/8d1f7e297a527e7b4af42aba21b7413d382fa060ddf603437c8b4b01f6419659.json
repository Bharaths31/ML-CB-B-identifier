{"nodes": [{"id": "agents_knowledge_context", "label": "CONTEXT.md \u2014 Context Database", "file_type": "document", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_breedclassifier", "label": "BreedClassifier (backbone + attention + 3 heads)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/model.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_efficientnet_lite", "label": "EfficientNet-Lite2/4 backbone", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/efficientnet_lite.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_cbam_attention", "label": "CBAM attention module", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/cbam.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_se_attention", "label": "SE (squeeze-excitation) attention module", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/cbam.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_three_head_classifier", "label": "3-head multi-task classifier (binary + cattle + buffalo)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/model.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heads are always sized 57 cattle + 18 buffalo regardless of data mode, so the architecture is identical across smoke/half/quarter/full training; unused outputs simply receive no gradient."}, {"id": "concept_masked_loss", "label": "masked multi-task loss (w_bin*CE + w_cat*CE + w_buf*CE)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/train.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_knowledge_distillation", "label": "Knowledge distillation (teacher to student)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/train.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distill a lite4 teacher into the unchanged lite2 student ((1-a)*hard CE + a*T^2*KL, a=0.7, T=4.0) to get teacher accuracy at zero on-device cost."}, {"id": "concept_ema", "label": "Weight EMA including BN buffers", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/train.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMA must update BatchNorm running stats (and hard-copy num_batches_tracked) in addition to parameters, otherwise exported phase-2 checkpoints carry stale BN stats while validation still looks plausible."}, {"id": "concept_qat", "label": "Quantization-Aware Training (opt-in phase 3)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/train.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QAT is opt-in with per-tensor observers because it is only an x86 accuracy-recovery tool; mobile INT8 comes from converter-side PTQ and phase-3 checkpoints cannot be re-exported."}, {"id": "concept_ptq", "label": "Converter-side PTQ (TFLite full-integer, ONNX QDQ)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/export.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_cutmix_mixup", "label": "CutMix / MixUp batch mixing on GPU", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/train.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_effective_number_sampler", "label": "Effective-number-of-samples WeightedRandomSampler (beta=0.999)", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "src/data_pipeline.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Softens pure inverse-frequency oversampling that would repeat 5-image breeds excessively, while still balancing rare breeds."}, {"id": "concept_android_deployment", "label": "Android / mobile INT8 deployment path", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_mobile_input_convention", "label": "Mobile input convention: RGB float32 [0,1] with normalization baked in", "file_type": "concept", "source_file": ".agents/knowledge/CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ImageNet normalization is baked into the mobile graphs so the Flutter app's existing pixel/255 preprocessing is exactly correct with zero app changes; outputs read by index 0=binary, 1=cattle, 2=buffalo."}], "edges": [{"source": "agents_knowledge_context", "target": "readme", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/knowledge/CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "agents_knowledge_context", "target": "concept_breedclassifier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/CONTEXT.md", "source_location": "\u00a74 Model Architecture", "weight": 1.0}, {"source": "agents_knowledge_context", "target": "concept_efficientnet_lite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/CONTEXT.md", "source_location"