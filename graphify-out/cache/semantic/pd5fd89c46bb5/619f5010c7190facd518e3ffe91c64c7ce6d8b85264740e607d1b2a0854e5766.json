{"nodes": [{"id": "docs_training_pipeline", "label": "Training Pipeline", "file_type": "document", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_training_pipeline_qat", "label": "QAT phase 3 (opt-in)", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in because Android INT8 now comes from converter-side PTQ; QAT is only a recovery tool when converter PTQ drops more than ~2 pts. Uses per-tensor observers and starts from the best phase-2 EMA checkpoint."}, {"id": "docs_training_pipeline_ema", "label": "EMA (Exponential Moving Average)", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMA_DECAY=0.999 tracks parameters AND BatchNorm buffers (running mean/var are EMA'd, num_batches_tracked copied). Removing the buffer sync produces checkpoints with stale BN statistics that silently degrade validation accuracy and every exported model."}, {"id": "docs_training_pipeline_masked_loss", "label": "masked_loss", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Species masking prevents the buffalo head from receiving gradient signal on cattle images and vice versa; binary term is species-balanced per batch to counter the 57:18 prior."}, {"id": "docs_training_pipeline_masked_kd_loss", "label": "masked_kd_loss", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distillation blend (1-a)*masked_loss + a*T^2*masked_KL with same species masking; with an identical teacher the KL term is exactly zero."}, {"id": "docs_training_pipeline_soft_ce", "label": "soft_ce (soft cross-entropy)", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports fractional label vectors produced by CutMix/MixUp mixed labels."}, {"id": "docs_training_pipeline_cutmix_mixup", "label": "CutMix / MixUp batch mixing", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strong regularization on GPU; applied 50% of steps with CutMix(alpha=1.0) / MixUp(alpha=0.3)."}, {"id": "docs_training_pipeline_sota_optimizations", "label": "SOTA optimizations", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AdamW weight_decay=1e-2, linear warmup -> cosine annealing, label smoothing 0.05, gradient accumulation 2 steps, gradient clipping max_norm=1.0."}, {"id": "docs_training_pipeline_data_modes", "label": "Data modes (smoke/half/quarter)", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_training_pipeline_knowledge_distillation", "label": "Knowledge distillation", "file_type": "concept", "source_file": "docs/training-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teacher accuracy in the student at zero on-device cost \u2014 student keeps the lite2 architecture, size, and latency. Defaults KD_ALPHA=0.7, KD_TEMPERATURE=4.0."}], "edges": [{"source": "docs_training_pipeline", "target": "docs_training_pipeline_qat", "relation": "r