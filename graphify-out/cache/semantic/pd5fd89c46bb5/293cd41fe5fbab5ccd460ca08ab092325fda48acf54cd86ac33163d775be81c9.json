{"nodes": [{"id": "adr", "label": "ADR-001: ML Architecture for Cattle & Buffalo Breed Recognition", "file_type": "document", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_ml_architecture_decision", "label": "Shared-backbone multi-head hierarchical architecture decision", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over incremental two-stage (Option A) and YOLOv8-Classify (Option C) because it fixes all five root causes (F1-F5) simultaneously; sharing the backbone computes the heavy Conv/MBConv layers once so two species models collapse from ~12 MB to ~2 MB, uniquely delivering more accuracy at less storage. Projected 83-87% test accuracy vs the 57.71% baseline against an 85% target."}, {"id": "adr_efficientnet_lite2", "label": "EfficientNet-Lite2 backbone", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MobileNetV2 lacked compound scaling and could not separate subtle inter-breed features (root cause F1); EfficientNet-Lite2 provides the capacity required for 60-class fine-grained visual classification."}, {"id": "adr_cbam", "label": "CBAM attention module", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed after backbone stage 4 for discriminative anatomical localization; provides implicit localization without a detection stage, eliminating two-stage error propagation (F3). CBAM channel-attention sigmoid is not natively quantizable in all TFLite backends."}, {"id": "adr_qat", "label": "Quantization-Aware Training (QAT)", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces post-training INT8 quantization (root cause F2), which under 10x compression stripped floating-point precision at class decision boundaries."}, {"id": "adr_two_stage_pipeline", "label": "Two-stage YOLO-Nano + MobileNetV2 pipeline", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference SIH 2025 implementation achieving only 57.71% test accuracy; two-stage error propagation (F3) irreversibly corrupts classifier input from bad YOLO-Nano crops."}, {"id": "adr_hierarchical_heads", "label": "Binary head + species-specific sub-heads", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hierarchical split reduces per-head class count from 60 to 35 cattle / 25 buffalo, directly lowering decision complexity; the binary head gates the prediction path and only two of three heads activate per image at inference."}, {"id": "adr_bharat_pashudhan_app", "label": "Bharat Pashudhan App (BPA)", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_sih_2025_ps_25004", "label": "SIH 2025 Problem Statement 25004", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_masked_per_head_loss", "label": "Masked per-head loss", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Species masks ensure buffalo images never penalize the cattle head and vice versa; loss weights 0.50/0.25/0.25 should be validated on the held-out split."}, {"id": "adr_guided_image_capture", "label": "Guided image capture overlay", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eliminates the explicit detection stage dependency, removing the YOLO crop quality gate at the cost of ~2 weeks of Android development."}, {"id": "adr_se_block", "label": "Squeeze-and-Excitation (SE) block", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fallback for CBAM channel attention: width-1 conv SE block has equivalent expressiveness and is fully TFLite-compatible."}, {"id": "adr_yolov8_classify", "label": "YOLOv8-Classify unified model (Option C)", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected because YOLO's classification head operates on stride-8/16 feature maps, losing fine-grained spatial detail critical for FGVC with 35+ visually similar classes; largest model of the three options despite lowest accuracy."}, {"id": "adr_mobilenetv2", "label": "MobileNetV2 backbone", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lacks compound scaling; upgrading to MobileNetV3-L adds capacity but not compound scaling, so F1 remains."}, {"id": "adr_yolo_nano", "label": "YOLO-Nano detector", "file_type": "concept", "source_file": "ADR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "adr", "target": "adr_ml_architecture_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADR.md", "source_location": null, "weight": 1.0}, {"source": "adr", "target": "adr_eff